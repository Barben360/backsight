# Generated by backsight: holds secrets (mode 0600). Do not edit; run backsight server render.
HINDSIGHT_API_DATABASE_URL='postgresql://hindsight:fakedbpassword@127.0.0.1:8889/hindsight'
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY='fakeapikey'
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-flash
HINDSIGHT_API_LLM_API_KEY='fakellmkey'
HINDSIGHT_API_LLM_TIMEOUT=300
# Facts, observations and reflect answers always in English, whatever language you write in: English facts are recalled better.
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=English
# Multilingual preset: multilingual-e5-small (onnx default) + mmarco reranker.
# On CPU reranking is ~98 % of a recall: 30 candidates of at most 128 tokens keep the prompt hook p95 under 2.5 s.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_RERANKER_PROVIDER=onnx
HINDSIGHT_API_RERANKER_ONNX_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=30
HINDSIGHT_API_RERANKER_MAX_TOKENS_PER_CANDIDATE=128
# LLM request log: token rows kept 30 days for stats and the backfill budget; no prompt or memory text stored.
HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=30
HINDSIGHT_API_LLM_TRACE_MAX_CHARS=1
# Stable worker id: tasks in flight survive a container recreate.
HINDSIGHT_API_WORKER_ID=backsight-box
# Native runtime: the API on this PC only, the models in HF_HOME, the database's port kept across renders.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HOME='/srv/bs/data/server/native/home'
HF_HOME='/srv/bs/data/server/native/hf'
BACKSIGHT_PG_PORT=8889
# No .env file from the server's directory or above overrides this file.
PYTHON_DOTENV_DISABLED=1
