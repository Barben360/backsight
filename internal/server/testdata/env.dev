# Generated by backsight: holds secrets (mode 0600). Do not edit; run backsight server render.
BACKSIGHT_DB_PASSWORD='fakedbpassword'
HINDSIGHT_API_DATABASE_URL='postgresql://hindsight:fakedbpassword@db:5432/hindsight'
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY='fakeapikey'
HINDSIGHT_CP_DATAPLANE_API_KEY='fakeapikey'
HINDSIGHT_CP_ACCESS_KEY='fakeuikey'
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-v4-flash
HINDSIGHT_API_LLM_API_KEY='fakellmkey'
HINDSIGHT_API_LLM_TIMEOUT=300
# Facts, observations and reflect answers always in English (decision 0039).
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=English
# Multilingual preset: multilingual-e5-small (onnx default) + mmarco reranker, CPU cap 60 candidates.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=60
# Stable worker id: tasks in flight survive a container recreate.
HINDSIGHT_API_WORKER_ID=backsight-box
