BACKSIGHT_HOME=/home/tester/backsight
BS_SERVER_URL=http://hindsight:8888
CODEX_HOME=/home/tester/.codex
HOME=/home/tester
HOSTNAME=codex-test
OLDPWD=/home/tester/work
PATH=/home/tester/.codex/tmp/arg0-linux/codex-arg0XXXXXX:/home/tester/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PWD=/home/tester/work
SHELL=/bin/bash
SHLVL=3
TERM=tmux-256color
TERM_PROGRAM=tmux
TERM_PROGRAM_VERSION=3.5a
TMUX=[scrubbed]
TMUX_PANE=%0
_=/usr/bin/env
