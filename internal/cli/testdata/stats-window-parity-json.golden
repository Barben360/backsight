{
  "schema_version": 1,
  "command": "stats",
  "ok": true,
  "data": {
    "days": 7,
    "window": true,
    "from": "2026-10-01T00:00:00Z",
    "to": "2026-10-08T00:00:00Z",
    "prompts": {
      "human": 3,
      "machine": 0,
      "recalls": 2,
      "with_hits": 1,
      "skips": {
        "short": 1
      },
      "p50_ms": 800,
      "p95_ms": 1200,
      "scope_calls": 1,
      "scope_failures": 0,
      "by_lang": {
        "en": [
          1,
          0
        ],
        "fr": [
          1,
          1
        ]
      }
    },
    "turns": {
      "long": 2,
      "searched": 0,
      "credit": {}
    },
    "injections": {
      "n": 1,
      "searched": 0,
      "credited": 0,
      "contradicted": 0,
      "searched_by_search": 0,
      "exact": 0
    },
    "briefings": {
      "n": 0,
      "empty": 0,
      "ids": 0,
      "used": 0,
      "model": 0
    },
    "detector": {
      "fired": 0,
      "saved": 0
    },
    "budget": {
      "sessions": 1,
      "p95_chars": 0
    },
    "gate": {},
    "tools": {},
    "live": {},
    "retains": {
      "ok": 1
    },
    "hook_failures": {},
    "unknown_records": {},
    "attribution": {
      "main": 0,
      "disagree": 0,
      "subagents": 0,
      "moved": 0
    },
    "feedback": {
      "checks": {
        "declared": 1
      },
      "declared_after_block": 0,
      "verdicts": {
        "used": 1
      },
      "refused": 0,
      "late": 0,
      "settled": {
        "shows": 4,
        "credits": 1,
        "misses": 1,
        "unknown": 0
      },
      "flags": {},
      "retired": 0,
      "hidden": 0,
      "partly": 0,
      "boost": {
        "prompts": 1,
        "prompts_set_changed": 1,
        "searches": 0,
        "searches_set_changed": 0
      },
      "imported": {
        "shows": 0,
        "credits": 0
      }
    },
    "server": {
      "notes_queued": 0,
      "sessions_waiting": 0
    },
    "runtime": "docker",
    "extraction": {
      "input_tokens": 0,
      "cached_tokens": 0,
      "output_tokens": 0,
      "days": 0,
      "error": "GET /v1/default/banks/claude-memory/llm-requests/stats: HTTP 500 (server_error): "
    },
    "parity": [
      {
        "metric": "recalls that injected something",
        "rule": "\u003e=",
        "baseline_n": 16,
        "baseline_of": 61,
        "bar_n": 16,
        "bar_of": 61,
        "n": 1,
        "of": 2,
        "verdict": "too few",
        "baseline": "26% (16/61)"
      },
      {
        "metric": "prompt hook p95",
        "rule": "\u003c=",
        "baseline_n": 4200,
        "bar_n": 0,
        "n": 1200,
        "of": 2,
        "latency": true,
        "verdict": "too few",
        "baseline": "4200 ms"
      },
      {
        "metric": "failed recall scope calls",
        "rule": "\u003c=",
        "baseline_n": 0,
        "baseline_of": 124,
        "bar_n": 1,
        "bar_of": 100,
        "n": 0,
        "of": 1,
        "verdict": "too few",
        "baseline": "0% (0/124), up to 1%"
      },
      {
        "metric": "injections followed by a memory_search",
        "rule": "\u003e=",
        "baseline_n": 7,
        "baseline_of": 16,
        "bar_n": 7,
        "bar_of": 16,
        "n": 0,
        "of": 1,
        "verdict": "too few",
        "baseline": "44% (7/16)"
      },
      {
        "metric": "injections credited (exact)",
        "rule": "\u003e=",
        "baseline_n": 3,
        "baseline_of": 16,
        "bar_n": 3,
        "bar_of": 16,
        "n": 0,
        "of": 1,
        "verdict": "too few",
        "baseline": "19% (3/16)"
      },
      {
        "metric": "replies after a search that cite the memory",
        "rule": "\u003e=",
        "baseline_n": 4,
        "baseline_of": 17,
        "bar_n": 4,
        "bar_of": 17,
        "n": 0,
        "of": 0,
        "verdict": "too few",
        "baseline": "24% (4/17)"
      }
    ]
  }
}
