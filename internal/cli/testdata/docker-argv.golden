# server install --api-port <port> --ui-port 19999
"volume" "inspect" "backsight_pg_data"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "pull"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "up" "-d" "--wait"
# server render
# server start
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "up" "-d" "--wait"
# server stop
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "stop"
# server status
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "ps" "--all" "--format" "json"
# backup create
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "rm -f /tmp/backsight-*.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select version_num from alembic_version"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select extversion from pg_extension where extname = 'vector'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_dump" "-U" "hindsight" "-d" "hindsight" "-Fc" "-f" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_restore" "--list" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t memory_units -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t documents -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t mental_models -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "cp" "db:/tmp/backsight-<rand>.dump" "<home>/backsight/state/staging/backup-<rand>/db.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "rm" "-f" "/tmp/backsight-<rand>.dump"
# backup verify <archive>
"run" "-d" "--network" "none" "--shm-size" "1g" "--name" "backsight-verify-<rand>" "-e" "POSTGRES_USER=hindsight" "-e" "POSTGRES_DB=hindsight" "-e" "POSTGRES_PASSWORD=verify-<rand>" "pgvector/pgvector:pg18@sha256:2358fcba361ed2233a5ed81b5fe4ca779ccb304120ce531a3bf51c0ed7e2bc11"
"exec" "backsight-verify-<rand>" "psql" "-h" "127.0.0.1" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select 1"
"cp" "<home>/backsight/state/staging/verify-<rand>/db.dump" "backsight-verify-<rand>:/tmp/db.dump"
"exec" "backsight-verify-<rand>" "pg_restore" "-U" "hindsight" "-d" "hindsight" "--no-owner" "--exit-on-error" "/tmp/db.dump"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from memory_units"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from documents"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from mental_models"
"rm" "-f" "-v" "backsight-verify-<rand>"
# restore <archive>
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "rm -f /tmp/backsight-*.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "rm -f /tmp/backsight-*.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select version_num from alembic_version"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select extversion from pg_extension where extname = 'vector'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_dump" "-U" "hindsight" "-d" "hindsight" "-Fc" "-f" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_restore" "--list" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t memory_units -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t documents -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t mental_models -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "cp" "db:/tmp/backsight-<rand>.dump" "<home>/backsight/state/staging/backup-<rand>/db.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "rm" "-f" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "stop" "hindsight"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "cp" "<home>/backsight/state/staging/verify-<rand>/db.dump" "db:/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "dropdb" "-U" "hindsight" "--if-exists" "--force" "hindsight"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "createdb" "-U" "hindsight" "hindsight"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_restore" "-U" "hindsight" "-d" "hindsight" "--no-owner" "--exit-on-error" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "rm" "-f" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select count(*) from memory_units"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select count(*) from documents"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select count(*) from mental_models"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "up" "-d" "--wait"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "up" "-d" "--wait"
# server upgrade
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "rm -f /tmp/backsight-*.dump"
"pull" "ghcr.io/vectorize-io/hindsight:1.2.0@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "rm -f /tmp/backsight-*.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select version_num from alembic_version"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select extversion from pg_extension where extname = 'vector'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_dump" "-U" "hindsight" "-d" "hindsight" "-Fc" "-f" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "pg_restore" "--list" "/tmp/backsight-<rand>.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t memory_units -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t documents -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "sh" "-c" "pg_restore --data-only -t mental_models -f - /tmp/backsight-<rand>.dump | awk '/^COPY /{c=1;next} /^\\\\\\.$/{c=0} c{n++} END{print n+0}'"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "cp" "db:/tmp/backsight-<rand>.dump" "<home>/backsight/state/staging/backup-<rand>/db.dump"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "rm" "-f" "/tmp/backsight-<rand>.dump"
"run" "-d" "--network" "none" "--shm-size" "1g" "--name" "backsight-verify-<rand>" "-e" "POSTGRES_USER=hindsight" "-e" "POSTGRES_DB=hindsight" "-e" "POSTGRES_PASSWORD=verify-<rand>" "pgvector/pgvector:pg18@sha256:2358fcba361ed2233a5ed81b5fe4ca779ccb304120ce531a3bf51c0ed7e2bc11"
"exec" "backsight-verify-<rand>" "psql" "-h" "127.0.0.1" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select 1"
"cp" "<home>/backsight/state/staging/verify-<rand>/safety.dump" "backsight-verify-<rand>:/tmp/db.dump"
"exec" "backsight-verify-<rand>" "pg_restore" "-U" "hindsight" "-d" "hindsight" "--no-owner" "--exit-on-error" "/tmp/db.dump"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from memory_units"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from documents"
"exec" "backsight-verify-<rand>" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-c" "select count(*) from mental_models"
"rm" "-f" "-v" "backsight-verify-<rand>"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "up" "-d" "--wait"
# bank rename
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select coalesce(json_agg(bank_id order by bank_id), '[]'::json) from banks"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "db" "psql" "-U" "hindsight" "-d" "hindsight" "-At" "-v" "ON_ERROR_STOP=1" "-c" "select count(*) from async_operations where bank_id in ('claude-memory', 'claude-memory-docs', 'claude-memory-control') and status in ('pending', 'processing')"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory" "--to" "backsight" "--dry-run"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory-docs" "--to" "backsight-docs" "--dry-run"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory-control" "--to" "backsight-control" "--dry-run"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory" "--to" "backsight"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory-docs" "--to" "backsight-docs"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "exec" "-T" "hindsight" "hindsight-admin" "rename-bank" "--from" "claude-memory-control" "--to" "backsight-control"
# uninstall --delete-data --answer confirm_bank=backsight
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "rm" "--stop" "--force" "-v"
"compose" "-p" "backsight" "--project-directory" "<home>/backsight/data/server" "-f" "<home>/backsight/data/server/compose.yaml" "down" "--remove-orphans"
"volume" "rm" "backsight_pg_data"
"volume" "rm" "backsight_hf_cache"
